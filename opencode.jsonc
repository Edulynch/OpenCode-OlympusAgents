{
  // GENERATED BY scripts/render_harnesses.py — edit Olympus Core/adapter sources, not this output.
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "kael",
  "model": "openai/gpt-6.1-sol",
  "permissions": [
    // External paths require native user approval; do not grant every path.
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    // Shell is globally denied; Kovan and Nox opt into trusted-project shell.
    // The hidden Aegis agent explicitly allows shell for /maintain only.
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    },
    // Child routing stays agent-specific; Kael's allowlist is authoritative.
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    },
    // Agent rules may specialize this ask. Olympus-owned paths stay native DENY;
    // WRITE_SCOPE remains a task ownership contract, not an OS sandbox.
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    }
  ]
}
