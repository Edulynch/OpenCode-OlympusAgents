{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "kael",
  "model": "{{opencode_kael_model}}",
  "mcp": {
    "servers": {
      "serena": {
        "type": "local",
        "command": [
          "serena",
          "start-mcp-server",
          "--context",
          "ide",
          "--transport",
          "stdio",
          "--project-from-cwd",
          "--enable-web-dashboard",
          "False",
          "--open-web-dashboard",
          "False"
        ],
        "disabled": false,
        "codemode": false
      }
    }
  },
  "permissions": [
    // External paths require native user approval; do not grant every path.
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    // Shell is globally denied; Kovan and Nox opt into trusted-project shell.
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    },
    // Child routing stays agent-specific; Kael's allowlist is authoritative.
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    },
    // Agent rules may specialize this ask. Olympus-owned paths stay native DENY;
    // WRITE_SCOPE remains a task ownership contract, not an OS sandbox.
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    }
  ]
}
