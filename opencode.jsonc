{
  // GENERATED BY scripts/render_harnesses.py — edit Olympus Core/adapter sources, not this output.
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "kael",
  "model": "openai/gpt-6.1-sol",
  "permissions": [
    // External paths ask by default. Keep this rule at the project level:
    // an agent-level wildcard ASK would override a more-specific user DENY.
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    // Deny Serena by default: agent-specific read-only grants come later,
    // while symbol edits, file writes, and REPL tools remain unavailable.
    {
      "action": "serena_*",
      "resource": "*",
      "effect": "deny"
    },
    // Shell is globally denied; Kovan and Nox opt into trusted-project shell.
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    },
    // Child routing stays agent-specific; Kael's allowlist is authoritative.
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    },
    // Agent rules may specialize this ask. Olympus-owned paths stay native DENY;
    // WRITE_SCOPE remains a task ownership contract, not an OS sandbox.
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    }
  ]
}
