{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "master-orchestrator",
  "model": "openai/gpt-6-sol",
  "permissions": [
    // Defense-in-depth: agents may operate only in the active project.
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    // Phase 2A keeps shell denied, including for the implementer. This also
    // prevents accidental cleanup, process spawning, and external writes.
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    },
    // Agent definitions add only their explicitly approved child-role or
    // scoped-write exceptions after this global deny.
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    },
    // Writer edit capability is granted only by the implementer definition
    // and remains narrower than this global deny.
    {
      "action": "edit",
      "resource": "*",
      "effect": "deny"
    }
  ]
}
