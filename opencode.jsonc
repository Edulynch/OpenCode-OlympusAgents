{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "kael",
  "model": "openai/gpt-6-sol",
  "permissions": [
    // Default for read-only agents; trusted-project Kovan/Nox opt into native
    // external-directory access for normal tool-managed temp and caches.
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    // Shell is globally denied; Kovan and Nox opt into trusted-project shell.
    // The hidden maintenance agent explicitly allows shell for /maintain only.
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    },
    // Agent definitions may add controlled child-role and edit exceptions after
    // this global deny; task contracts still define dynamic write scope.
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    },
    // Kovan-specific rules protect sensitive edit paths; WRITE_SCOPE remains
    // a task ownership contract, not an OS sandbox.
    {
      "action": "edit",
      "resource": "*",
      "effect": "deny"
    }
  ]
}
