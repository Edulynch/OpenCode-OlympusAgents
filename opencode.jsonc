{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "kael",
  "model": "openai/gpt-6-sol",
  "permissions": [
    // Defense-in-depth: agents may operate only in the active project.
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    // Shell is globally denied; Nox adds only exact validation-command
    // exceptions in its agent policy. All other agents retain shell denial.
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    },
    // Agent definitions may add controlled child-role and edit exceptions after
    // this global deny; task contracts still define dynamic write scope.
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    },
    // Kovan-specific rules constrain the global edit deny to authorized
    // project files and keep sensitive orchestration paths protected.
    {
      "action": "edit",
      "resource": "*",
      "effect": "deny"
    }
  ]
}
